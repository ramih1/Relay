generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  passwordHash     String
  role             String             @default("Member")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tasks            Task[]
  notes            Note[]
  reminders        Reminder[]
  calendarEvents   CalendarEvent[]
  notifications    Notification[]
  emailDrafts      EmailDraft[]
  pendingActions   PendingAction[]
  actionLogs       ActionLog[]
  assistantRuns    AssistantRequest[]
  sessions         Session[]
  workspace        WorkspaceState?
  googleConnection GoogleConnection?
  oauthStates      GoogleOAuthState[]
  workouts         WorkoutLog[]
  meals            MealLog[]
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WorkspaceState {
  id        String   @id @default(uuid())
  userId    String   @unique
  data      Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleConnection {
  id              String    @id @default(uuid())
  userId          String    @unique
  encryptedTokens String
  scopes          String[]
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleOAuthState {
  nonce        String   @id
  userId       String
  service      String
  redirectPath String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WorkoutLog {
  id              String   @id @default(uuid())
  userId          String
  activity        String
  durationMinutes Int
  caloriesBurned  Int?
  intensity       String
  notes           String?
  performedAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, performedAt])
}

model MealLog {
  id        String   @id @default(uuid())
  userId    String
  name      String
  mealType  String
  calories  Int
  protein   Float?
  carbs     Float?
  fat       Float?
  eatenAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eatenAt])
}

model Task {
  id          String     @id @default(uuid())
  userId      String
  title       String
  description String?
  due         String
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, priority])
}

model Reminder {
  id        String         @id @default(uuid())
  userId    String
  title     String
  when      String
  repeat    RepeatRule     @default(NONE)
  priority  Priority       @default(MEDIUM)
  status    ReminderStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model CalendarEvent {
  id        String    @id @default(uuid())
  userId    String
  title     String
  detail    String
  start     String
  end       String
  location  String?
  tone      EventTone @default(TEAL)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  summary   String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  title     String
  body      String
  category  NotificationCategory @default(LATER)
  source    String
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

model EmailDraft {
  id        String           @id @default(uuid())
  userId    String
  recipient String
  subject   String
  body      String
  tone      EmailTone        @default(PROFESSIONAL)
  status    EmailDraftStatus @default(DRAFT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model PendingAction {
  id          String              @id @default(uuid())
  userId      String
  type        PendingActionType   @default(CREATE_TASK)
  title       String
  description String
  risk        RiskLevel           @default(MEDIUM)
  status      PendingActionStatus @default(PENDING)
  payload     Json
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model ActionLog {
  id         String            @id @default(uuid())
  userId     String
  title      String
  detail     String
  category   ActionLogCategory
  impact     ActionImpact
  happenedAt DateTime          @default(now())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, happenedAt])
}

model AssistantRequest {
  id         String                 @id @default(uuid())
  userId     String
  input      String
  outcome    String
  status     AssistantRequestStatus @default(QUEUED)
  happenedAt DateTime               @default(now())
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, happenedAt])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  DONE
  OVERDUE
}

enum ReminderStatus {
  ACTIVE
  SNOOZED
  DONE
}

enum RepeatRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum EventTone {
  TEAL
  GOLD
  ROSE
}

enum NotificationCategory {
  URGENT
  IMPORTANT
  LATER
  LOW
}

enum EmailTone {
  PROFESSIONAL
  FRIENDLY
  SHORT
  FORMAL
}

enum EmailDraftStatus {
  DRAFT
  APPROVED
}

enum PendingActionType {
  CREATE_REMINDER
  CREATE_TASK
  CREATE_CALENDAR_EVENT
  DRAFT_EMAIL
  CREATE_TASKS_FROM_NOTE
}

enum PendingActionStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ActionLogCategory {
  ASSISTANT
  APPROVAL
  PRODUCTIVITY
  SYSTEM
}

enum ActionImpact {
  INFO
  SUCCESS
  WARNING
}

enum AssistantRequestStatus {
  QUEUED
  PROPOSAL_CREATED
  COMPLETED
  NEEDS_CLARIFICATION
}
